---
Language: Cpp
AlignAfterOpenBracket: AlwaysBreak # Align
AllowAllArgumentsOnNextLine: true
AllowAllParametersOfDeclarationOnNextLine: true
AllowShortFunctionsOnASingleLine: None
AlwaysBreakTemplateDeclarations: Yes
BinPackArguments: false
BinPackParameters: false
BraceWrapping:
    AfterCaseLabel: true
    AfterClass: true
    AfterControlStatement: Always
    AfterFunction: true
    AfterStruct: true
    BeforeCatch: true
    BeforeElse: true
    BeforeLambdaBody: true
BreakBeforeBraces: Custom
BreakInheritanceList: AfterColon
BreakConstructorInitializers: AfterColon
ColumnLimit: 110
QualifierAlignment: Right
EmptyLineAfterAccessModifier: Always
EmptyLineBeforeAccessModifier: Always
PackConstructorInitializers: Never
AllowAllConstructorInitializersOnNextLine: true
# Includes with lower priority magnitudes end up higher in the list of includes
# More general / 3rd party / std headers must have higher priorities
# More specific / local / lue headers must have lower priorities
IncludeCategories:
    - Regex: '^"lue/view/'
      Priority: 10
    - Regex: '^"lue/qa/'
      Priority: 20
    - Regex: '^"lue/framework/'
      Priority: 30
    - Regex: '^"lue/data_model/'
      Priority: 40
    - Regex: '^"lue/test/'
      Priority: 50
    - Regex: '^"lue/python/'
      Priority: 60
    - Regex: '^"lue/gdal/'
      Priority: 70
    - Regex: '^"lue/imgui/'
      Priority: 70
    - Regex: '^"lue/netcdf/'
      Priority: 70
    - Regex: '^"lue/shared/'
      Priority: 80
    - Regex: '^"lue/'
      Priority: 90
    - Regex: "^(<hpx/|<cxxopts.hpp>)"
      Priority: 100
    - Regex: "^<vulkan/"
      Priority: 105
    - Regex: "^<(boost|fmt|numpy|pybind11)/"
      Priority: 110
    - Regex: "^<.*"
      Priority: 120
    - Regex: '^".*'
      Priority: 1
###   - Regex:           '^"(llvm|llvm-c|clang|clang-c)/'
###     Priority:        2
###     SortPriority:    0
###     CaseSensitive:   false
###   - Regex:           '^(<|"(gtest|gmock|isl|json)/)'
###     Priority:        3
###     SortPriority:    0
###     CaseSensitive:   false
###   - Regex:           '.*'
###     Priority:        1
###     SortPriority:    0
###     CaseSensitive:   false
IndentAccessModifiers: true
IndentCaseLabels: true
IndentWidth: 4
MaxEmptyLinesToKeep: 2
NamespaceIndentation: All
PenaltyReturnTypeOnItsOwnLine: 160 # Default: 60
PointerAlignment: Left
SortIncludes: true
SpaceAfterTemplateKeyword: false
SpaceBeforeCtorInitializerColon: false
SpaceBeforeInheritanceColon: false
SpacesBeforeTrailingComments: 2
Standard: Auto
